{
  "name": "coding-arena",
  "private": true,
  "description": "Coding Arena — 1v1 timed coding duels (web app, game server, shared package)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace apps/web",
    "dev:server": "npm run dev --workspace apps/server",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace apps/server",
    "db:migrate": "npm run db:migrate --workspace apps/server",
    "db:studio": "npm run db:studio --workspace apps/server"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
