# Web env — copy to apps/web/.env.local (never commit real values)

# Google OAuth client ID, read server-side at runtime by the login page
# (same variable name the game server uses).
GOOGLE_CLIENT_ID=

# Optional local-dev fallback only — NOT needed on Vercel.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Where /api/* is proxied. Locally: http://localhost:4000
# On Vercel: https://duel1v1.onrender.com
API_ORIGIN=

# Direct game-server origin for live sockets (F05). Browsers connect here for
# room/match updates; auth uses one-time tokens from /api/duels/socket-token.
# Locally: http://localhost:4000 | On Vercel: https://duel1v1.onrender.com
NEXT_PUBLIC_GAME_WS_URL=

# F10 error tracking (Sentry). Empty/absent = Sentry never loads, app runs
# exactly as before. Browser DSN from a free sentry.io project.
NEXT_PUBLIC_SENTRY_DSN=
