# Web env — copy to apps/web/.env.local (never commit real values)

# Google OAuth client ID, read server-side at runtime by the login page
# (same variable name the game server uses).
GOOGLE_CLIENT_ID=

# Optional local-dev fallback only — NOT needed on Vercel.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Where /api/* is proxied. Locally: http://localhost:4000
# On Vercel: https://duel1v1.onrender.com
API_ORIGIN=
