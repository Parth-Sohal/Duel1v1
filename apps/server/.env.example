# Server env — copy to apps/server/.env (never commit real values)

# PostgreSQL (Neon) connection string
DATABASE_URL=

# Server
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Auth (Iteration 1): the OAuth client ID used to verify Google ID tokens
# (audience check). No client secret needed — tokens are verified against
# Google's public keys.
GOOGLE_CLIENT_ID=

# Code execution via Judge0 (Iteration 2)
JUDGE0_API_URL=
JUDGE0_API_KEY=

# F10 hardening: comma-separated owner emails allowed to read analytics
# counts (GET /api/events/counts) and the feedback list (GET /api/feedback).
OWNER_EMAILS=

# F10 error tracking (Sentry). Empty/absent = Sentry never loads, app runs
# exactly as before. Create a free project at sentry.io, server (Node) DSN.
SENTRY_DSN=

# F09 daily-challenge pick salt. Deterministic date-seeded selection; any
# non-empty string. Changing it after launch changes nothing (the day's pick
# is cached in daily_challenges on first request).
DAILY_SALT=kern-arena-v1

# F11 AI code analysis (Iteration 5). Absent = feature off (the web app hides
# the Analyze affordance). Create a free key at aistudio.google.com.
GEMINI_API_KEY=
# Optional overrides (defaults shown)
AI_MODEL=gemini-3.5-flash
AI_DAILY_LIMIT=3
AI_MAX_CODE_CHARS=20000
