# Server env: copy to apps/server/.env
# Web env: copy the web block to apps/web/.env.local
# (never commit real values)

# PostgreSQL (Neon) connection string
DATABASE_URL=

# Server
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Auth (Iteration 1)
# Server: the OAuth client ID used to verify Google ID tokens (audience check)
GOOGLE_CLIENT_ID=
# Web: the SAME variable name works — the login page reads GOOGLE_CLIENT_ID
# server-side at runtime (set it in Vercel). NEXT_PUBLIC_ is only a local-dev
# fallback and is not needed on Vercel.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Web: where /api/* is proxied (set in apps/web/.env.local; on Vercel set
# API_ORIGIN to the Render URL)
API_ORIGIN=

# Code execution via Judge0 (Iteration 2)
JUDGE0_API_URL=
JUDGE0_API_KEY=

# AI feedback (Iteration 5)
LLM_API_KEY=
